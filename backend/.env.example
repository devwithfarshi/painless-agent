DATABASE_URL=postgres://postgres:postgres@localhost:2345/painless-agent?sslmode=disable
REDIS_URL=redis://localhost:2346

# LLM provider: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
# LLM_MODEL=                  # defaults per provider (claude-sonnet-4-20250514 / gpt-4o)

# Embedding provider: always "openai" (Anthropic has no embeddings API)
# Embeddings use text-embedding-3-small (1536 dims) — changing this requires re-embedding all memories
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# Debug: set AGENT_GOAL to run a single task synchronously on server start
# AGENT_GOAL=Research the history of Go programming language and write a summary
