# ── Infrastructure (required) ────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:2345/painless-agent?sslmode=disable
REDIS_URL=redis://localhost:2346

# ── LLM chat provider ─────────────────────────────────────────────────────────
# One of: "anthropic" (default), "openai", "copilot"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
# LLM_MODEL=                        # defaults per provider (claude-sonnet-4-20250514 / gpt-4o)

# GitHub Copilot — no API key needed; device-code OAuth runs on first use.
# Token cached at ~/.painless-agent/copilot_token

# ── Embedding provider ────────────────────────────────────────────────────────
# Always "openai" — Anthropic has no embeddings API.
# Changing this requires re-embedding all stored memories (1536 dims).
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY required above for embeddings even when LLM_PROVIDER != openai.
# If OPENAI_API_KEY is absent the memory store is disabled (agent still works).

# ── Web search ────────────────────────────────────────────────────────────────
# Brave Search (primary): https://brave.com/search/api/ — 2 000 free queries/month
# BRAVE_API_KEY=your-brave-api-key

# SerpAPI (fallback, uses Google): https://serpapi.com — 250 free searches/month
# SERP_API_KEY=your-serpapi-key

# ── Filesystem tool ───────────────────────────────────────────────────────────
# Root directory the agent may read/write. Paths outside this are rejected.
# Relative to the working directory (backend/). Defaults to "workspace".
# FILESYSTEM_ROOT=workspace

# ── Tool limits ───────────────────────────────────────────────────────────────
# TOOL_MAX_OUTPUT_KB=32     # max tool output before LLM summarisation (default: 32 KB)
# TOOL_TIMEOUT_SECS=30      # HTTP request / tool execution timeout (default: 30 s)
# HTTP_MAX_BODY_KB=256      # max HTTP response body size (default: 256 KB)

# ── Debug ─────────────────────────────────────────────────────────────────────
# Set AGENT_GOAL to run a single autonomous task on server start, then exit.
# Comment out (or leave unset) to just start the server and wait.
# AGENT_GOAL=Research the history of Go programming language and write a summary
